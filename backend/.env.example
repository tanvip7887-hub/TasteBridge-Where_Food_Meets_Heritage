PORT=5000
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/tastebridge"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="your_admin_password_here"

# Feature Flags
EMAIL_ENABLED=true
RABBITMQ_ENABLED=true

# Email / Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="TasteBridge <no-reply@tastebridge.com>"
EMAIL_FROM="TasteBridge <no-reply@tastebridge.com>"

# RabbitMQ Message Broker Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EMAIL_QUEUE=tastebridge.email
